#!/usr/bin/env ruby
# frozen_string_literal: true

# maf - multi-agent-flow command line tool.
#
# Run maf in the project root. maf uses the current directory as the project.
# Link this file into a directory on PATH. maf resolves the link to find lib/.
cli = File.expand_path("../lib/maf/cli.rb", File.dirname(File.realpath(__FILE__)))
abort "maf: cannot find #{cli}. Link bin/maf into PATH with ln -s. Do not copy it." unless File.exist?(cli)
require cli

Maf::CLI.new(ARGV).run
