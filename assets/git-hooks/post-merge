# Doc-graph refresh: start it detached; the hook never fails a commit.
_doc_graph_main=$(cd "$(git rev-parse --git-common-dir 2>/dev/null)/.." 2>/dev/null && pwd)
if [ -n "$_doc_graph_main" ] && [ -x "$_doc_graph_main/.maf/bin/doc-graph-refresh" ]; then
    nohup "$_doc_graph_main/.maf/bin/doc-graph-refresh" post-merge >/dev/null 2>&1 &
fi
# <<< multi-agent-flow <<<
