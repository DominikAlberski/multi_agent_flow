# >>> multi-agent-flow >>>
# The flow keeps every file in .maf/. Git tracks bin/, agents/, and config.json.
# Git does not track the runtime state, the worktrees, and the generated output.
# coordination/ holds the task board, messages, locks, hooks, sessions, and logs.
# taskrc and taskdata hold an absolute local path and the task database itself.
.maf/coordination/
.maf/worktrees/
.maf/graphify-out/
.maf/obsidian/
.maf/*.log
.maf/*.pid
# env.sh is written by `coord worktree` in each worktree. It holds absolute paths.
.maf/env.sh
# <<< multi-agent-flow <<<
