      </style>
    </head>
    <body>
      <header>
        <h1 id="proj">Flow Board</h1>
        <span class="muted" id="upd">Loading...</span>
        <button id="pbtn" onclick="togglePause()">Pause</button>
      </header>
      <div id="alerts" class="alerts"></div>
      <div id="stats" class="stats"></div>
      <div class="card" style="margin-bottom:10px"><h3>Workers</h3><div id="workers"></div></div>
      <div class="card" style="margin-bottom:10px"><h3>Knowledge graph</h3><div id="graph"></div></div>
      <div id="roles" class="grid"></div>
      <div class="two">
        <div class="card"><h3>Recent Events</h3><div id="events"></div></div>
        <div>
          <div class="card" style="margin-bottom:10px"><h3>Inboxes</h3><div id="inboxes"></div></div>
          <div class="card"><h3>Locks</h3><div id="locks"></div></div>
        </div>
      </div>
      <script>
        let paused = false, INTERVAL = 5, timer = null;
        const TOKEN = '__TOKEN__';
        const $ = id => document.getElementById(id);
        const meta = text => `<div class="meta">${text}</div>`;
        const muted = text => `<div class="muted">${text}</div>`;

        function k(n) {
          if (n == null) return '-';
          if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
          return n >= 1e3 ? Math.round(n / 1e3) + 'k' : String(n);
        }
        function ago(iso) {
          const s = Math.round((Date.now() - new Date(iso)) / 1000);
          if (s < 60) return s + 's';
          if (s < 3600) return Math.floor(s / 60) + 'm';
          return Math.floor(s / 3600) + 'h ' + Math.floor((s % 3600) / 60) + 'm';
        }
        function esc(s) {
          return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }
        function b(t, l) { return `<span class="b b-${l}">${t}</span>`; }
        function ac(a) {
          const classes = { done: 'ad', claim: 'ac', unclaim: 'au', msg: 'am', broadcast: 'am' };
          return classes[a] || '';
        }
        function togglePause() {
          paused = !paused;
          $('pbtn').textContent = paused ? 'Resume' : 'Pause';
          if (!paused) refresh();
        }

        async function act(id, action) {
          if (action !== 'start' && !confirm(action + ' ' + id + '? A running agent finishes its run first.')) return;
          const headers = { 'Content-Type': 'application/json', 'X-Maf-Token': TOKEN };
          const body = JSON.stringify({ worker: id, action: action });
          const r = await fetch('/action', { method: 'POST', headers: headers, body: body })
            .then(r => r.json()).catch(e => ({ error: e.message }));
          if (r.error) alert(r.error);
          refresh(true);
        }

        function state(w) {
          const s = w.status || {};
          if (!w.live) return b('stopped', 'danger');
          if (!w.dispatch) return b('live', 'ok');
          return s.running ? b('run ' + ago(s.run_started_at), 'info') : b('idle', 'ok');
        }
        function ctx(w) {
          const s = w.status || {};
          if (s.context_tokens == null) return '-';
          const pct = s.context_window ? ' (' + Math.round(100 * s.context_tokens / s.context_window) + '%)' : '';
          const over = s.context_limit && s.context_tokens >= s.context_limit;
          return (over ? b('over limit', 'warn') + ' ' : '') + k(s.context_tokens) + pct;
        }
        function lastRun(w) {
          const r = (w.status || {}).last_run;
          if (!r) return '-';
          const badge = b(r.success ? 'ok' : 'failed', r.success ? 'ok' : 'danger');
          return badge + ' ' + ago(r.finished_at) + ' ago<div class="log">' + esc(r.detail) + '</div>';
        }
        function buttons(w) {
          if (!w.dispatch && !w.live) return '<div class="log">cd ' + esc(w.dir) + ' &amp;&amp; maf start</div>';
          const acts = w.dispatch ? (w.live ? ['stop', 'restart'] : ['start']) : ['stop'];
          return acts.map(a => `<button class="act" onclick="act('${esc(w.id)}','${a}')">${a}</button>`).join('');
        }
        function logLines(w) {
          const lines = (w.dispatch ? w.log : []).concat(w.action.length ? ['action: ' + w.action.at(-1)] : []);
          return lines.length ? '<div class="log">' + esc(lines.join('\\n')) + '</div>' : '';
        }
        function tokens(w) {
          const u = w.usage || {};
          const rest = `${k(u.cached_input_tokens)} cached &middot; ${k(u.output_tokens)} out`
            + ` &middot; ${u.runs || 0} runs`;
          return k(u.input_tokens) + ' in' + meta(rest);
        }
        function taskCell(w, tasks) {
          const cur = tasks.find(t => t.worker === w.id && t.start);
          return cur ? esc(cur.description) + meta(esc(cur.uuid.slice(0, 8))) : '-';
        }
        function workerRow(w, tasks) {
          const s = w.status || {};
          const runs = s.session_runs != null ? meta('session run ' + (s.session_runs + 1)) : '';
          const cells = [
            `<strong>${esc(w.id)}</strong>` + meta(esc(w.role)),
            esc(w.harness) + meta(w.dispatch ? 'dispatch' : 'interactive'),
            esc(s.model || w.model || 'harness default') + runs,
            state(w) + (w.last_event ? meta('event ' + ago(w.last_event) + ' ago') : ''),
            ctx(w) + (w.handoff_at ? meta('note ' + ago(w.handoff_at) + ' ago') : ''),
            taskCell(w, tasks), lastRun(w), tokens(w), buttons(w) + logLines(w)
          ];
          return '<tr>' + cells.map(c => `<td>${c}</td>`).join('') + '</tr>';
        }
        function renderWorkers(ws, tasks) {
          const names = ['Worker', 'Harness', 'Model', 'State', 'Context', 'Task', 'Last run', 'Tokens', 'Actions'];
          const head = '<tr>' + names.map(n => `<th>${n}</th>`).join('') + '</tr>';
          const rows = ws.map(w => workerRow(w, tasks)).join('');
          $('workers').innerHTML = ws.length ? '<table>' + head + rows + '</table>'
            : muted('no workers yet. Run maf prepare or maf start.');
        }

        function taskAlerts(d) {
          const t = d.tasks, alerts = [];
          const add = (list, l, text) => { if ((list || []).length) alerts.push({ l: l, m: list.length + text }); };
          add(t.stale, 'danger', ' claimed task(s) with expired lease — likely crashed worker');
          add(t.orphaned, 'danger', ' task(s) assigned to roles nobody is running');
          add(t.escalated, 'danger', ' task(s) escalated to the project manager — waiting for a decision');
          add(t.in_review, 'warn', ' goal pull request(s) wait for your review on GitHub');
          add(t.conflicts, 'warn', ' scope conflict(s) between pending tasks');
          return alerts;
        }
        function otherAlerts(d) {
          const alerts = [];
          Object.entries(d.inboxes || {}).filter(([, msgs]) => msgs.length)
            .forEach(([role, msgs]) => alerts.push({ l: 'warn', m: `${role} inbox: ${msgs.length} unread messages` }));
          (d.locks || []).filter(l => l.stale).forEach(l =>
            alerts.push({ l: 'danger', m: 'Stale lock: ' + l.name + ' held by ' + (l.worker || '?') + ', expired' }));
          return alerts;
        }
        function workerAlerts(ws) {
          const stopped = ws.filter(w => !w.live && w.dispatch)
            .map(w => ({ l: 'danger', m: 'Dispatched worker ' + w.id + ' is stopped' }));
          const run = w => (w.status || {}).last_run || {};
          const failed = ws.filter(w => run(w).success === false)
            .map(w => ({ l: 'warn', m: `Last run of ${w.id} failed: ${(run(w).detail || '').slice(0, 100)}` }));
          return stopped.concat(failed);
        }
        function renderAlerts(alerts) {
          const html = a => `<div class="alert ${a.l === 'warn' ? 'warn' : ''}">&#x26A0; ${esc(a.m)}</div>`;
          $('alerts').innerHTML = alerts.map(html).join('');
        }

        function waiting(t, now) { return t.wait && new Date(t.wait) > now; }
        function renderStats(d, tasks, now) {
          const stale = d.tasks.stale || [];
          const stats = [
            { v: tasks.length, l: 'Pending' }, { v: tasks.filter(t => t.start).length, l: 'In Progress', c: 'info' },
            { v: tasks.filter(t => !t.start && !waiting(t, now)).length, l: 'Backlog' },
            { v: tasks.filter(t => waiting(t, now)).length, l: 'Waiting' },
            { v: stale.length, l: 'Stale', c: stale.length ? 'danger' : '' },
            { v: (d.declared_roles || []).length, l: 'Roles' }, { v: (d.workers || []).length, l: 'Workers' }
          ];
          const color = s => s.c ? ` style="color:var(--${s.c})"` : '';
          const html = s => `<div class="stat"><div class="sv"${color(s)}>${s.v}</div>`
            + `<div class="sl">${s.l}</div></div>`;
          $('stats').innerHTML = stats.map(html).join('');
        }
        function renderGraph(g) {
          if (!g) return $('graph').innerHTML = muted('graph age unknown');
          const age = g.commits == null ? 'no age' : g.commits + ' commits since build';
          $('graph').innerHTML = `<div class="row">${b(g.state, g.state === 'fresh' ? 'ok' : 'warn')} `
            + `<span class="meta">${age}</span></div>`;
        }

        function taskRow(badge, t, detail) {
          return `<div class="row">${badge} <strong>${esc(t.description)}</strong>` + meta(detail) + '</div>';
        }
        function claimedRow(t, staleIds) {
          const badge = staleIds.has(t.uuid) ? b('stale', 'danger') : b('claimed', 'info');
          const scope = t.scope ? ' &middot; ' + esc(t.scope) : '';
          return taskRow(badge, t, `${esc(t.worker || '')} &middot; ${ago(t.start)} ago${scope}`);
        }
        function groupByRole(roles, tasks, now) {
          const byRole = {};
          const group = r => byRole[r] = byRole[r] || { c: [], bl: [], w: [] };
          roles.forEach(group);
          tasks.forEach(t => {
            const g = group(t.role || 'unassigned');
            (waiting(t, now) ? g.w : t.start ? g.c : g.bl).push(t);
          });
          return byRole;
        }
        function renderRoles(d, tasks, now) {
          const roles = d.declared_roles || [];
          const staleIds = new Set((d.tasks.stale || []).map(t => t.uuid));
          $('roles').innerHTML = Object.entries(groupByRole(roles, tasks, now)).map(([role, g]) => {
            const orphan = roles.length > 0 && role !== 'goal' && !roles.includes(role);
            const rows = g.c.map(t => claimedRow(t, staleIds))
              .concat(g.bl.map(t => taskRow(b('backlog', 'ok'), t, esc(t.scope || ''))))
              .concat(g.w.map(t => taskRow(b('waiting', 'warn'), t, esc(t.scope || ''))));
            return `<div class="card"><h3>${esc(role)}${orphan ? ' ' + b('no runner', 'danger') : ''}</h3>`
              + (rows.join('') || muted('no tasks')) + '</div>';
          }).join('');
        }

        function renderEvents(events) {
          const row = e => `<div class="er"><span class="ets">${ago(e.ts)} ago</span>`
            + `<span class="ea ${ac(e.action)}">${esc(e.action)}</span>`
            + `<span>${esc(e.worker)} ${e.detail ? '&mdash; ' + esc(e.detail.slice(0, 55)) : ''}</span></div>`;
          const recent = (events || []).slice().reverse().slice(0, 25);
          $('events').innerHTML = recent.map(row).join('') || muted('no events yet');
        }
        function renderInboxes(inboxes) {
          const message = m => `<div class="row" style="padding-left:10px">`
            + `<span class="meta">${esc(m.from || '?')}${m.at ? ' &middot; ' + ago(m.at) + ' ago' : ''}</span>`
            + `<div>${esc(m.preview)}</div></div>`;
          const box = ([role, msgs]) => `<div class="row"><span>${esc(role)}</span> `
            + `${msgs.length ? b(msgs.length + ' unread', 'warn') : b('clear', 'ok')}</div>`
            + msgs.map(message).join('');
          const list = Object.entries(inboxes || {});
          $('inboxes').innerHTML = list.length ? list.map(box).join('') : muted('no inboxes');
        }
        function renderLocks(locks) {
          const badge = l => l.stale ? b('stale', 'danger') : b('held', 'info');
          const row = l => `<div class="row"><span>${esc(l.name)}</span> ${badge(l)} `
            + `<span class="meta" style="margin-left:4px">${esc(l.worker || '')} &middot; `
            + `expires ${ago(l.expires_at)}</span></div>`;
          $('locks').innerHTML = (locks || []).length ? locks.map(row).join('') : muted('no active locks');
        }

        function render(d) {
          INTERVAL = d.refresh_interval || 5;
          $('proj').textContent = d.project + ' — Flow Board';
          $('upd').textContent = 'Updated ' + ago(d.generated_at) + ' | lease ' + Math.round(d.lease_ttl / 3600) + 'h';
          const tasks = d.tasks.all || [], now = new Date(), ws = d.workers || [];
          renderAlerts(taskAlerts(d).concat(otherAlerts(d), workerAlerts(ws)));
          renderStats(d, tasks, now);
          renderWorkers(ws, tasks);
          renderGraph(d.graph);
          renderRoles(d, tasks, now);
          renderEvents(d.events);
          renderInboxes(d.inboxes);
          renderLocks(d.locks);
        }

        async function refresh(now) {
          if (paused && !now) return;
          clearTimeout(timer);
          try { render(await fetch('/data').then(r => r.json())); }
          catch (e) { $('upd').textContent = 'Error: ' + e.message; }
          timer = setTimeout(refresh, INTERVAL * 1000);
        }
        refresh();
      </script>
    </body>
