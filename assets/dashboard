  # BoardCheck finds out if the coordination folder exists. The default folder
  # is relative, so a wrong working directory gives an empty page without it.
  class BoardCheck
    def initialize(cfg)
      @cfg = cfg
    end

    # Returns an error text, or nil if the task board exists.
    def problem
      return nil if File.exist?(@cfg.taskrc)
      "no task board at #{File.expand_path(@cfg.coord_dir)}.\n" \
        "Run dashboard from the project root, or pass --coord DIR.#{old_layout_hint}"
    end

    private

    def old_layout_hint
      File.exist?("coordination/taskrc") ? "\nThis project uses the old layout. Run: maf migrate" : ""
    end
  end

  # Server serves the page, the data, and the worker actions. An action needs
  # the token of this server run, which only the page knows, and a localhost
  # Host header. So another web site in the browser cannot start an action.
  class Server
    def initialize(cfg)
      @cfg       = cfg
      @collector = Collector.new(cfg)
      @actions   = ActionRunner.new(cfg)
      @token     = SecureRandom.hex(16)
    end

    def run
      problem = BoardCheck.new(@cfg).problem
      abort "dashboard: #{problem}" if problem
      server = build_server
      server.mount_proc("/")     { |_, res| html(res) }
      server.mount_proc("/data") { |_, res| json(res) }
      server.mount_proc("/action") { |req, res| action(req, res) }
      trap("INT") { server.shutdown }
      puts "dashboard: http://localhost:#{@cfg.port}  (ctrl-c to stop)"
      server.start
    end

    private

    def build_server
      WEBrick::HTTPServer.new(BindAddress: "127.0.0.1",
                              Port: @cfg.port,
                              Logger: WEBrick::Log.new(File::NULL),
                              AccessLog: [])
    end

    def html(res)
      res.content_type = "text/html; charset=utf-8"
      res.body = PAGE_HTML.sub("__TOKEN__", @token)
    end

    def action(req, res)
      res.content_type = "application/json"
      error = refusal(req) || @actions.run(*JSON.parse(req.body.to_s).values_at("worker", "action").map(&:to_s))
      res.status = error ? 400 : 202
      res.body = JSON.generate(error ? { error: error } : { ok: true })
    rescue JSON::ParserError
      res.status = 400
      res.body = JSON.generate(error: "the body is not JSON")
    end

    def refusal(req)
      return "use POST" unless req.request_method == "POST"
      return "wrong token" unless req["X-Maf-Token"] == @token

      "wrong host" unless req.host.to_s.match?(/\A(localhost|127\.0\.0\.1)\z/)
    end

    def json(res)
      res.content_type = "application/json"
      res.body = JSON.generate(@collector.collect)
    end
  end
end

Dashboard::Server.new(Dashboard::Config.new(ARGV)).run if __FILE__ == $PROGRAM_NAME
