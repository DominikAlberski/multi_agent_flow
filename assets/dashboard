#!/usr/bin/env ruby
# frozen_string_literal: true

# dashboard - local observability web UI for multi-agent coordination.
#
# Usage: dashboard [--port N] [--coord DIR] [--interval S]
#
# Starts a local HTTP server at http://localhost:4567 (default).
# The page auto-refreshes every S seconds (default: 5).
# Run from the project root where .maf/coordination/ lives.
#
# >>> multi-agent-flow >>>
# <<< multi-agent-flow <<<

require "json"
require "fileutils"
require "time"
require "optparse"
require "rbconfig"
require "securerandom"
begin
  require "webrick"
rescue LoadError
  abort "dashboard: webrick is required. Install it with: gem install webrick"
end

abort "dashboard: Ruby 3.0+ required (current: #{RUBY_VERSION})." if RUBY_VERSION.split(".").first.to_i < 3

module Dashboard
  DEFAULT_PORT     = 4567
  DEFAULT_INTERVAL = 5
  DEFAULT_COORD    = ".maf/coordination"
  DEFAULT_LEASE    = 4 * 3600

  class Config
    attr_reader :port, :coord_dir, :interval, :maf

    def initialize(argv)
      @port     = DEFAULT_PORT
      @coord_dir = DEFAULT_COORD
      @interval  = DEFAULT_INTERVAL
      @maf       = "maf"
      OptionParser.new do |o|
        o.on("--port N", Integer)    { |v| @port = v }
        o.on("--coord DIR")          { |v| @coord_dir = v }
        o.on("--interval S", Integer) { |v| @interval = v }
        o.on("--maf PATH")           { |v| @maf = v }
      end.parse!(argv)
    end

    def taskrc       = File.join(coord_dir, "taskrc")
    def log_path     = File.join(coord_dir, "events.log")
    def inbox_dir    = File.join(coord_dir, "inbox")
    def locks_dir    = File.join(coord_dir, "locks")
    def manifest     = File.join(File.dirname(coord_dir), "config.json")
    def workers_path = File.join(coord_dir, "workers.json")
    def usage_dir    = File.join(coord_dir, "usage")
    def vault_path   = File.join(File.dirname(File.expand_path(coord_dir)), "bin", "vault")
    def root         = File.dirname(File.dirname(File.expand_path(coord_dir)))
    def lease_ttl
      v = Integer(ENV.fetch("COORD_LEASE_TTL", ""), exception: false)
      v&.positive? ? v : DEFAULT_LEASE
    end
  end

  class TaskReader
    def initialize(taskrc)
      @taskrc = taskrc
    end

    def read
      return [] unless File.exist?(@taskrc)
      env = ENV.to_h.merge("TASKRC" => @taskrc)
      IO.popen([env, "task", "(", "status:pending", "or", "status:waiting", ")", "export",
                { err: File::NULL }]) { |f| parse(f.read) }
    rescue StandardError
      []
    end

    private

    def parse(raw)
      raw.strip.empty? ? [] : JSON.parse(raw)
    rescue JSON::ParserError
      []
    end
  end

  # TokenReader reads the token usage that the dispatcher adds up per worker in
  # .maf/coordination/usage/<worker>.json. A broken file counts as no usage.
  class TokenReader
    def initialize(dir)
      @dir = dir
    end

    def read
      Dir.glob(File.join(@dir, "*.json")).sort.to_h do |path|
        [File.basename(path, ".json"), JSON.parse(File.read(path))]
      rescue JSON::ParserError
        [File.basename(path, ".json"), {}]
      end
    end
  end

# GraphReader asks `vault age --json` for the graph age. An absent vault
# script or a failure gives nil.
class GraphReader
  def initialize(cfg)
    @cfg = cfg
  end

  def read
    JSON.parse(IO.popen([RbConfig.ruby, @cfg.vault_path, "age", "--json"], chdir: @cfg.root, err: File::NULL, &:read))
  rescue SystemCallError, JSON::ParserError
    nil
  end
end

  # WorkerReader puts every fact about one worker in one record: the registry
  # entry (.maf/coordination/workers.json), presence, the status that the
  # dispatcher or the context-watch hook writes, token usage, the last log
  # lines, and the result of the last dashboard action.
  class WorkerReader
    PS_ENV = { "TZ" => "UTC", "LC_ALL" => "C" }.freeze
    LOG_LINES = 5

    def initialize(cfg)
      @cfg = cfg
    end

    def read(id, entry)
      entry.merge("id" => id, "live" => live?(file("presence", id)), "status" => file("status", id),
                  "usage" => file("usage", id), "log" => tail("#{id}.log"), "action" => tail("#{id}.control.log"),
                  "handoff_at" => mtime(File.join(sessions, "#{id}.handoff.md")))
    end

    private

    def sessions = File.join(@cfg.coord_dir, "sessions")

    def file(dir, id)
      path = File.join(@cfg.coord_dir, dir, "#{id}.json")
      File.exist?(path) ? JSON.parse(File.read(path)) : {}
    rescue JSON::ParserError
      {}
    end

    # A pid can belong to a new process. The recorded start time tells them apart.
    def live?(presence)
      pid = presence["pid"].to_i
      pid.positive? && alive?(pid) && [nil, "", started_at(pid)].include?(presence["started"])
    end

    def alive?(pid)
      Process.kill(0, pid) && true
    rescue Errno::ESRCH
      false
    rescue Errno::EPERM
      true
    end

    def started_at(pid) = IO.popen(PS_ENV, ["ps", "-o", "lstart=", "-p", pid.to_s], err: File::NULL, &:read).strip

    def tail(name)
      path = File.join(sessions, name)
      File.exist?(path) ? File.readlines(path).last(LOG_LINES).map(&:chomp) : []
    end

    def mtime(path) = File.exist?(path) ? File.mtime(path).utc.iso8601 : nil
  end

  # ActionRunner runs `maf worker ACTION ID` in the background. A stop can
  # wait for a running agent, so the request does not wait for the command.
  # The output goes to sessions/<id>.control.log, which the page shows.
  class ActionRunner
    ACTIONS = %w[start stop restart].freeze

    def initialize(cfg)
      @cfg = cfg
    end

    # Returns an error text, or nil when the command started.
    def run(id, action)
      return "unknown action #{action}" unless ACTIONS.include?(action)
      return "unknown worker #{id}" unless registered?(id)

      spawn_maf(id, action)
    end

    private

    def registered?(id)
      JSON.parse(File.read(@cfg.workers_path)).key?(id)
    rescue Errno::ENOENT, JSON::ParserError
      false
    end

    def spawn_maf(id, action)
      log = File.join(@cfg.coord_dir, "sessions", "#{id}.control.log")
      FileUtils.mkdir_p(File.dirname(log))
      File.write(log, "[#{Time.now.utc.iso8601}] maf worker #{action} #{id}\n", mode: "a")
      pid = spawn(@cfg.maf, "worker", action, id, chdir: @cfg.root, in: File::NULL, out: [log, "a"], err: %i[child out])
      Process.detach(pid) && nil
    rescue SystemCallError => e
      "maf did not start: #{e.message}. Put maf on PATH or pass --maf PATH."
    end
  end

  class Collector
    def initialize(cfg)
      @cfg = cfg
    end

    def collect
      tasks = TaskReader.new(@cfg.taskrc).read
      {
        project:          File.basename(Dir.pwd),
        generated_at:     Time.now.utc.iso8601,
        refresh_interval: @cfg.interval,
        lease_ttl:        @cfg.lease_ttl,
        declared_roles:   declared_roles,
        workers:          workers,
        tokens:           TokenReader.new(@cfg.usage_dir).read,
        graph:            GraphReader.new(@cfg).read,
        tasks:            task_summary(tasks),
        events:           recent_events,
        inboxes:          inbox_messages,
        locks:            active_locks
      }
    end

    private

    def declared_roles
      JSON.parse(File.read(@cfg.manifest)).fetch("agents", []).map { |entry| entry["role"] }.compact
    rescue Errno::ENOENT, JSON::ParserError
      []
    end

    # .maf/coordination/workers.json lists each worker that `maf prepare` or
    # `maf start` set up. The last event shows when the worker last acted.
    def workers
      last = recent_events(500).to_h { |event| [event[:worker], event[:ts]] }
      reader = WorkerReader.new(@cfg)
      registry = JSON.parse(File.read(@cfg.workers_path))
      registry.map { |id, entry| reader.read(id, entry).merge("last_event" => last[id]) }
    rescue Errno::ENOENT, JSON::ParserError
      []
    end

    def task_summary(tasks)
      {
        all:       tasks,
        stale:     tasks.select { |t| stale?(t) },
        orphaned:  orphaned(tasks),
        conflicts: scope_conflicts(tasks),
        escalated: tasks.select { |t| escalated?(t) },
        in_review: tasks.select { |t| in_review?(t) }
      }
    end

    # `coord escalate --task` annotates the task. A done task leaves the
    # pending list, so only an open escalation shows.
    def escalated?(task)
      (task["annotations"] || []).any? { |note| note["description"].to_s.start_with?("ESCALATED:") }
    end

    # `coord goal pr` annotates the goal with its pull request. The goal
    # stays open until the pull request merges.
    def in_review?(task)
      task["role"] == "goal" && (task["annotations"] || []).any? { |note| note["description"].to_s.start_with?("PR:") }
    end

    def stale?(task)
      start = task["start"].to_s
      return false if start.empty?
      Time.parse(start) + @cfg.lease_ttl <= Time.now
    rescue ArgumentError
      false
    end

    def orphaned(tasks)
      roles = declared_roles
      return [] if roles.empty?
      # Goals are not work for a role, so a goal never lacks a runner.
      tasks.select { |t| t["role"] && t["role"] != "goal" && !roles.include?(t["role"]) }
    end

    def scope_conflicts(tasks)
      tasks.combination(2)
           .select { |a, b| scopes_overlap?(a["scope"], b["scope"]) }
           .map { |a, b| [a["uuid"], b["uuid"]] }
    end

    def scopes_overlap?(a, b)
      return false if a.to_s.empty? || b.to_s.empty?
      pa = non_glob_parts(a)
      pb = non_glob_parts(b)
      return false if pa.empty? || pb.empty?
      short, long = [pa, pb].sort_by(&:size)
      short == long.first(short.size)
    end

    def non_glob_parts(scope)
      scope.split("/").take_while { |p| p !~ /[*?{}]/ }
    end

    def recent_events(limit = 60)
      path = @cfg.log_path
      return [] unless File.exist?(path)
      File.readlines(path).last(limit).filter_map { |line| parse_event(line.chomp) }
    end

    def parse_event(line)
      ts, action, worker, detail = line.split("\t", 4)
      return nil unless ts && action
      { ts: ts, action: action, worker: worker, detail: detail }
    end

    def inbox_messages
      dir = @cfg.inbox_dir
      return {} unless Dir.exist?(dir)
      Dir.children(dir).each_with_object({}) do |role, h|
        rdir = File.join(dir, role)
        next unless File.directory?(rdir)
        h[role] = Dir.glob(File.join(rdir, "*.md")).sort.filter_map { |p| read_message(p) }
      end
    end

    def read_message(path)
      header, body = File.read(path).split("\n\n", 2)
      { from: header[/^# from: (.+)$/, 1], at: header[/^# at: (.+)$/, 1],
        preview: body.to_s.strip.slice(0, 140) }
    rescue Errno::ENOENT
      nil
    end

    def active_locks
      dir = @cfg.locks_dir
      return [] unless Dir.exist?(dir)
      Dir.glob(File.join(dir, "*.json")).filter_map { |p| read_lock(p) }
    end

    def read_lock(meta)
      data = JSON.parse(File.read(meta))
      name = File.basename(meta, ".json")
      ts   = data["ts"].to_i
      ttl  = data.fetch("ttl") { nil }&.to_i
      return nil unless ttl&.positive?
      { name: name, worker: data["worker"], acquired_at: Time.at(ts).utc.iso8601,
        expires_at: Time.at(ts + ttl).utc.iso8601, stale: ts + ttl < Time.now.to_i }
    rescue JSON::ParserError, Errno::ENOENT
      nil
    end
  end

  PAGE_HTML = <<~HTML
    <!DOCTYPE html>
    <html lang="en">
    <head>
      <meta charset="utf-8">
      <title>Flow Board</title>
      <style>
        :root{--bg:#0f1117;--surface:#1a1d27;--border:#2a2d3a;--text:#e2e8f0;--muted:#64748b;
          --ok:#22c55e;--warn:#f59e0b;--danger:#ef4444;--info:#3b82f6}
        *{box-sizing:border-box;margin:0;padding:0}
        body{background:var(--bg);color:var(--text);font:13px/1.5 'SF Mono',Consolas,monospace;padding:16px}
