        .act:hover{border-color:var(--info)}
        .log{white-space:pre-wrap;color:var(--muted);font-size:10px;max-width:420px}
      </style>
    </head>
    <body>
      <header>
        <h1 id="proj">Flow Board</h1>
        <span class="muted" id="upd">Loading...</span>
        <button id="pbtn" onclick="togglePause()">Pause</button>
      </header>
      <div id="alerts" class="alerts"></div>
      <div id="stats" class="stats"></div>
      <div class="card" style="margin-bottom:10px"><h3>Workers</h3><div id="workers"></div></div>
      <div class="card" style="margin-bottom:10px"><h3>Knowledge graph</h3><div id="graph"></div></div>
      <div id="roles" class="grid"></div>
      <div class="two">
        <div class="card"><h3>Recent Events</h3><div id="events"></div></div>
        <div>
          <div class="card" style="margin-bottom:10px"><h3>Inboxes</h3><div id="inboxes"></div></div>
          <div class="card"><h3>Locks</h3><div id="locks"></div></div>
        </div>
      </div>
      <script>
        let paused=false,INTERVAL=5;const TOKEN='__TOKEN__';
        function k(n){return n==null?'-':n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?Math.round(n/1e3)+'k':String(n)}
        async function act(id,action){
          if(action!=='start'&&!confirm(action+' '+id+'? A running agent finishes its run first.'))return;
          const r=await fetch('/action',{method:'POST',headers:{'Content-Type':'application/json','X-Maf-Token':TOKEN},
            body:JSON.stringify({worker:id,action:action})}).then(r=>r.json()).catch(e=>({error:e.message}));
          if(r.error)alert(r.error);refresh(true);
        }
        function state(w){
          const s=w.status||{};
          if(!w.live)return b('stopped','danger');
          if(w.dispatch)return s.running?b('run '+ago(s.run_started_at),'info'):b('idle','ok');
          return b('live','ok');
        }
        function ctx(w){
          const s=w.status||{};if(s.context_tokens==null)return'-';
          const pct=s.context_window?' ('+Math.round(100*s.context_tokens/s.context_window)+'%)':'';
          const over=s.context_limit&&s.context_tokens>=s.context_limit;
          return(over?b('over limit','warn')+' ':'')+k(s.context_tokens)+pct;
        }
        function lastRun(w){
          const r=(w.status||{}).last_run;if(!r)return'-';
          return b(r.success?'ok':'failed',r.success?'ok':'danger')+' '+ago(r.finished_at)+' ago<div class="log">'+esc(r.detail)+'</div>';
        }
        function buttons(w){
          if(!w.dispatch&&!w.live)return'<div class="log">cd '+esc(w.dir)+' &amp;&amp; maf start</div>';
          const acts=w.dispatch?(w.live?['stop','restart']:['start']):['stop'];
          return acts.map(a=>`<button class="act" onclick="act('${esc(w.id)}','${a}')">${a}</button>`).join('');
        }
        function workerRows(ws,tasks){
          return ws.map(w=>{
            const s=w.status||{},u=w.usage||{},cur=tasks.filter(t=>t.worker===w.id&&t.start);
            const model=s.model||w.model||'harness default';
            const log=(w.dispatch?w.log:[]).concat(w.action.length?['action: '+w.action[w.action.length-1]]:[]);
            return`<tr><td><strong>${esc(w.id)}</strong><div class="meta">${esc(w.role)}</div></td>
              <td>${esc(w.harness)}<div class="meta">${w.dispatch?'dispatch':'interactive'}</div></td>
              <td>${esc(model)}${s.session_runs!=null?'<div class="meta">session run '+(s.session_runs+1)+'</div>':''}</td>
              <td>${state(w)}${w.last_event?'<div class="meta">event '+ago(w.last_event)+' ago</div>':''}</td>
              <td>${ctx(w)}${w.handoff_at?'<div class="meta">note '+ago(w.handoff_at)+' ago</div>':''}</td>
              <td>${cur.length?esc(cur[0].description)+'<div class="meta">'+esc(cur[0].uuid.slice(0,8))+'</div>':'-'}</td>
              <td>${lastRun(w)}</td>
              <td>${k(u.input_tokens)} in<div class="meta">${k(u.cached_input_tokens)} cached &middot; ${k(u.output_tokens)} out &middot; ${u.runs||0} runs</div></td>
              <td>${buttons(w)}${log.length?'<div class="log">'+esc(log.join('\\n'))+'</div>':''}</td></tr>`
          }).join('');
        }
        function togglePause(){paused=!paused;document.getElementById('pbtn').textContent=paused?'Resume':'Pause';if(!paused)refresh()}
        function ago(iso){const s=Math.round((Date.now()-new Date(iso))/1000);return s<60?s+'s':s<3600?Math.floor(s/60)+'m':Math.floor(s/3600)+'h '+Math.floor((s%3600)/60)+'m'}
        function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
        function b(t,l){return`<span class="b b-${l}">${t}</span>`}
        function ac(a){return a==='done'?'ad':a==='claim'?'ac':a==='unclaim'?'au':a==='msg'||a==='broadcast'?'am':''}

        function render(d){
          INTERVAL=d.refresh_interval||5;
          const ago_gen=ago(d.generated_at);
          document.getElementById('proj').textContent=d.project+' — Flow Board';
          document.getElementById('upd').textContent='Updated '+ago_gen+' | lease '+Math.round(d.lease_ttl/3600)+'h';

          const stale=d.tasks.stale||[],orphaned=d.tasks.orphaned||[],conflicts=d.tasks.conflicts||[];
          const alerts=[];
          if(stale.length) alerts.push({l:'danger',m:stale.length+' claimed task(s) with expired lease — likely crashed worker'});
          if(orphaned.length) alerts.push({l:'danger',m:orphaned.length+' task(s) assigned to roles nobody is running'});
          const escalated=d.tasks.escalated||[];
          if(escalated.length) alerts.push({l:'danger',m:escalated.length+' task(s) escalated to the project manager — waiting for a decision'});
          const inReview=d.tasks.in_review||[];
          if(inReview.length) alerts.push({l:'warn',m:inReview.length+' goal pull request(s) wait for your review on GitHub'});
          if(conflicts.length) alerts.push({l:'warn',m:conflicts.length+' scope conflict(s) between pending tasks'});
          Object.entries(d.inboxes||{}).forEach(([role,msgs])=>{if(msgs.length)alerts.push({l:'warn',m:role+' inbox: '+msgs.length+' unread message(s)'})});
          (d.locks||[]).filter(l=>l.stale).forEach(l=>alerts.push({l:'danger',m:'Stale lock: '+esc(l.name)+' held by '+(l.worker||'?')+', expired'}));
          document.getElementById('alerts').innerHTML=alerts.map(a=>`<div class="alert ${a.l==='warn'?'warn':''}">&#x26A0; ${esc(a.m)}</div>`).join('');

          const tasks=d.tasks.all||[],now=new Date();
          const claimed=tasks.filter(t=>t.start),backlog=tasks.filter(t=>!t.start&&!(t.wait&&new Date(t.wait)>now)),waiting=tasks.filter(t=>t.wait&&new Date(t.wait)>now);
          document.getElementById('stats').innerHTML=[
            {v:tasks.length,l:'Pending',c:''},{v:claimed.length,l:'In Progress',c:'info'},
            {v:backlog.length,l:'Backlog',c:''},{v:waiting.length,l:'Waiting',c:''},
            {v:stale.length,l:'Stale',c:stale.length?'danger':''},{v:(d.declared_roles||[]).length,l:'Roles',c:''},{v:(d.workers||[]).length,l:'Workers',c:''}
          ].map(s=>`<div class="stat"><div class="sv"${s.c?' style="color:var(--'+s.c+')"':''}>${s.v}</div><div class="sl">${s.l}</div></div>`).join('');

          const ws=d.workers||[];
          const head='<tr><th>Worker</th><th>Harness</th><th>Model</th><th>State</th><th>Context</th><th>Task</th><th>Last run</th><th>Tokens</th><th>Actions</th></tr>';
          document.getElementById('workers').innerHTML=ws.length?'<table>'+head+workerRows(ws,tasks)+'</table>':'<div class="muted">no workers yet. Run maf prepare or maf start.</div>';
          ws.filter(w=>!w.live&&w.dispatch).forEach(w=>alerts.push({l:'danger',m:'Dispatched worker '+w.id+' is stopped'}));
          ws.filter(w=>(w.status||{}).last_run&&!w.status.last_run.success).forEach(w=>alerts.push({l:'warn',m:'Last run of '+w.id+' failed: '+(w.status.last_run.detail||'').slice(0,100)}));
          document.getElementById('alerts').innerHTML=alerts.map(a=>`<div class="alert ${a.l==='warn'?'warn':''}">&#x26A0; ${esc(a.m)}</div>`).join('');

          const g=d.graph;
          document.getElementById('graph').innerHTML=g?`<div class="row">${b(g.state,g.state==='fresh'?'ok':'warn')} <span class="meta">${g.commits==null?'no age':g.commits+' commits since build'}</span></div>`:'<div class="muted">graph age unknown</div>';

          const roles=d.declared_roles||[];
          const byRole={};
          roles.forEach(r=>{byRole[r]={c:[],bl:[],w:[]}});
          tasks.forEach(t=>{const r=t.role||'unassigned';if(!byRole[r])byRole[r]={c:[],bl:[],w:[]};(t.wait&&new Date(t.wait)>now?byRole[r].w:t.start?byRole[r].c:byRole[r].bl).push(t)});
          const staleIds=new Set(stale.map(t=>t.uuid));
          document.getElementById('roles').innerHTML=Object.entries(byRole).map(([role,g])=>{
            const isOrph=roles.length>0&&role!=='goal'&&!roles.includes(role);
            const rows=[
              ...g.c.map(t=>`<div class="row">${staleIds.has(t.uuid)?b('stale','danger'):b('claimed','info')} <strong>${esc(t.description)}</strong><div class="meta">${esc(t.worker||'')} &middot; ${ago(t.start)} ago${t.scope?' &middot; '+esc(t.scope):''}</div></div>`),
              ...g.bl.map(t=>`<div class="row">${b('backlog','ok')} <strong>${esc(t.description)}</strong><div class="meta">${t.scope?esc(t.scope):''}</div></div>`),
              ...g.w.map(t=>`<div class="row">${b('waiting','warn')} <strong>${esc(t.description)}</strong><div class="meta">${t.scope?esc(t.scope):''}</div></div>`)
            ];
            return`<div class="card"><h3>${esc(role)}${isOrph?' '+b('no runner','danger'):''}</h3>${rows.join('')||'<div class="muted">no tasks</div>'}</div>`
          }).join('');

          const evts=(d.events||[]).slice().reverse().slice(0,25);
          document.getElementById('events').innerHTML=evts.map(e=>`<div class="er"><span class="ets">${ago(e.ts)} ago</span><span class="ea ${ac(e.action)}">${esc(e.action)}</span><span>${esc(e.worker)} ${e.detail?'&mdash; '+esc(e.detail.slice(0,55)):''}</span></div>`).join('')||'<div class="muted">no events yet</div>';

          const inboxes=Object.entries(d.inboxes||{});
          document.getElementById('inboxes').innerHTML=inboxes.length?inboxes.map(([role,msgs])=>{
            const head=`<div class="row"><span>${esc(role)}</span> ${msgs.length?b(msgs.length+' unread','warn'):b('clear','ok')}</div>`;
            const body=msgs.map(m=>`<div class="row" style="padding-left:10px"><span class="meta">${esc(m.from||'?')}${m.at?' &middot; '+ago(m.at)+' ago':''}</span><div>${esc(m.preview)}</div></div>`).join('');
            return head+body;
          }).join(''):'<div class="muted">no inboxes</div>';

          const lks=d.locks||[];
          document.getElementById('locks').innerHTML=lks.length?lks.map(l=>`<div class="row"><span>${esc(l.name)}</span> ${l.stale?b('stale','danger'):b('held','info')} <span class="meta" style="margin-left:4px">${esc(l.worker||'')} &middot; expires ${ago(l.expires_at)}</span></div>`).join(''):'<div class="muted">no active locks</div>';
        }

        let timer=null;
        async function refresh(now){
          if(paused&&!now)return;
          clearTimeout(timer);
          try{const d=await fetch('/data').then(r=>r.json());render(d)}
          catch(e){document.getElementById('upd').textContent='Error: '+e.message}
          timer=setTimeout(refresh,INTERVAL*1000);
        }
        refresh();
      </script>
    </body>
