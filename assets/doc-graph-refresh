#!/usr/bin/env ruby
# frozen_string_literal: true

# doc-graph-refresh - rebuild the knowledge graph after a markdown change.
#
# The git post-commit and post-merge hooks call this script with the event
# name. The hook starts the script detached, so the commit returns at once.
# The script exits 0 in every case: a failed refresh must never fail a commit.
#
# The script writes the shared graph in the MAIN checkout, resolved from
# git-common-dir. A refresh started in a worktree therefore writes the one
# shared graph. It builds in a temp dir and swaps on success, so a failed
# extract keeps the old graph.
#
# Usage: coordination/doc-graph-refresh post-commit|post-merge

require "fileutils"
require "tmpdir"
require "time"

abort "doc-graph-refresh: Ruby 3.0+ required (current: #{RUBY_VERSION})." if RUBY_VERSION.split(".").first.to_i < 3

# DocGraph refreshes graphify-out/graph.json after a markdown change.
module DocGraph
  GRAPH = "graphify-out"
  LOG = "coordination/doc-graph.log"
  LOCK = "coordination/doc-graph.lock"
  PENDING = "coordination/doc-graph.pending"
  EVENTS = %w[post-commit post-merge].freeze
  MARKDOWN = /\.md\z/i

  # Runs one refresh for the event. Returns nil for an unknown event, for a
  # change without a markdown file, and without a Gemini key.
  def self.run(event)
    return unless EVENTS.include?(event)
    return skip(event) unless ready?(event)

    Lock.hold { loop_until_clear }
  end

  def self.ready?(event)
    return false unless markdown?(event)

    !ENV["GEMINI_API_KEY"].to_s.empty?
  end

  def self.skip(event)
    reason = markdown?(event) ? "GEMINI_API_KEY unset, skipped" : "no markdown change"
    Log.write("#{event}: #{reason}")
  end

  def self.markdown?(event)
    Git.changed(event).any? { |file| file.match?(MARKDOWN) }
  end

  # A change during a run sets the pending flag. The holder loops until the
  # flag stays clear, so no change is lost.
  def self.loop_until_clear
    Lock.clear_pending
    Refresh.run
    loop_until_clear if Lock.pending?
  end

  def self.main
    common = Git.read("rev-parse", "--git-common-dir")
    common.empty? ? Dir.pwd : File.expand_path("..", common)
  end

  def self.graph_path = File.join(main, GRAPH)

  # Git lists the files a hook covers.
  module Git
    def self.changed(event)
      args = event == "post-merge" ? ["diff", "--name-only", "ORIG_HEAD", "HEAD"] : changed_commit
      read(*args).lines.map(&:strip).reject(&:empty?)
    end

    def self.changed_commit
      ["diff-tree", "--no-commit-id", "--name-only", "-r", "HEAD"]
    end

    def self.read(*args)
      IO.popen(["git", *args], err: File::NULL, &:read).strip
    rescue Errno::ENOENT
      ""
    end
  end

  # Lock serialises refreshes with a lock dir and a pending flag.
  module Lock
    def self.hold
      return mark_pending unless acquire

      begin
        yield
      ensure
        clear_pending
        release
      end
    end

    def self.acquire
      FileUtils.mkdir_p(File.dirname(path(LOCK)))
      Dir.mkdir(path(LOCK))
      true
    rescue SystemCallError
      false
    end

    def self.release
      Dir.rmdir(path(LOCK))
    rescue SystemCallError
      nil
    end

    def self.mark_pending
      FileUtils.mkdir_p(File.dirname(path(PENDING)))
      FileUtils.touch(path(PENDING))
      Log.write("refresh already running; marked pending")
    end

    def self.clear_pending = FileUtils.rm_f(path(PENDING))
    def self.pending? = File.exist?(path(PENDING))
    def self.path(name) = File.join(DocGraph.main, name)
  end

  # Refresh builds the graph in a temp dir, swaps it in, then re-exports.
  module Refresh
    def self.run
      tmp = Dir.mktmpdir("doc-graph-refresh")
      refresh(tmp)
    rescue StandardError => e
      Log.write("refresh failed: #{e.message}")
    ensure
      FileUtils.remove_entry(tmp) if tmp
    end

    def self.refresh(tmp)
      return Log.write("extract failed; kept the old graph") unless build(tmp)

      Swap.move(File.join(tmp, GRAPH), DocGraph.graph_path)
      Export.run
    end

    def self.build(tmp)
      ok = system("graphify", "extract", DocGraph.main, "--backend", "gemini", "--out", tmp)
      ok && File.exist?(File.join(tmp, GRAPH, "graph.json"))
    end
  end

  # Swap replaces the graph dir and restores the old one on failure.
  module Swap
    def self.move(fresh, dest)
      old = "#{dest}.old"
      FileUtils.rm_rf(old)
      FileUtils.mv(dest, old) if File.exist?(dest)
      FileUtils.mv(fresh, dest)
      FileUtils.rm_rf(old)
    rescue StandardError
      FileUtils.mv(old, dest) if File.exist?(old)
      raise
    end
  end

  # Export regenerates the Obsidian notes from the shared graph.
  module Export
    def self.run
      Dir.chdir(DocGraph.main) { system("graphify", "export", "obsidian", "--dir", "obsidian") }
    end
  end

  # Log appends one line to coordination/doc-graph.log in the main checkout.
  module Log
    def self.write(message)
      File.open(path, "a") { |io| io.puts("#{Time.now.utc.iso8601} #{message}") }
    rescue SystemCallError
      nil
    end

    def self.path
      path = File.join(DocGraph.main, DocGraph::LOG)
      FileUtils.mkdir_p(File.dirname(path))
      path
    end
  end
end

begin
  DocGraph.run(ARGV.first)
rescue StandardError => e
  warn "doc-graph-refresh: #{e.message}"
end
