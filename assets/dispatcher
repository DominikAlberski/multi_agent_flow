#!/usr/bin/env ruby
# frozen_string_literal: true

# dispatcher - task board and inbox monitor that starts one-shot agents.
#
# The dispatcher solves two problems:
# 1. A long-lived interactive agent session burns tokens while idle. The
#    dispatcher starts an agent only when there is work, and the agent exits
#    when the work is done (one-shot mode).
# 2. An agent that stops has no external watcher to restart it. The
#    dispatcher polls the inbox and the task board on a fixed interval.
#
# Usage:
#   dispatcher ROLE [--harness NAME | --command TEMPLATE] [--model M]
#                     [--skill NAME | --no-skill] [--interval S] [--max-turns N]
#                     [--timeout S] [--idle-timeout S] [--grace S]
#                     [--completion-signal TEXT] [--abort-signal TEXT]
#                     [--cache-window S] [--max-session-runs N] [--no-poll-tasks]
#                     [--once] [--verbose]
#
#   dispatcher tester                            # hermes (default)
#   dispatcher reviewer --harness claude --model sonnet
#   dispatcher backend-developer --harness opencode --model openrouter/qwen3-coder
#   dispatcher reviewer --harness codex
#   dispatcher reviewer --once                   # one poll cycle, then exit
#
# Flags:
#   --harness NAME     Built-in adapter: hermes (default), claude, codex, or
#                      opencode. Each one resumes sessions.
#   --command TEMPLATE Any other harness. A shell command with %{prompt},
#                      %{role}, %{skill}, and %{model} placeholders, each
#                      shell-escaped. The command must exit when done.
#                      Sessions are not resumed for custom commands.
#   --model M          Model for the agent, in the harness CLI's own format.
#   --skill NAME       Hermes skill to preload. Default: <project>-<role> when
#                      flow.rb generated it.
#   --no-skill         Do not preload a skill.
#   --interval S       Poll interval in seconds (default: 60).
#   --max-turns N      Hermes max tool-calling turns per run (default: 50).
#   --timeout S        Max wall-clock seconds per run. Default: team.timeouts.<role>
#                      in .maf/config.json, else 1500. The
#                      dispatcher kills the agent's process group after it.
#   --idle-timeout S   Fail a run that prints no output for S seconds
#                      (default: 0, off). Claude Code prints its JSON only at
#                      the end, so keep this off for --harness claude.
#   --grace S          Seconds to wait for the agent to exit after the
#                      completion signal, and for a child that holds stdout
#                      (default: 5).
#   --completion-signal TEXT  The agent prints TEXT when the work is complete.
#                      The run is a success, and the dispatcher stops the
#                      agent after the grace window. Default: off.
#   --abort-signal TEXT  The agent prints TEXT when it gives up. The run is a
#                      failure. Default: off.
#   --cache-window S   Resume a session only if its last run ended less than
#                      S seconds ago (default: 3300, 55 minutes). 0 means
#                      never resume.
#   --max-session-runs N  Start a fresh session after N runs in one session
#                      (default: 5). Each resume sends the whole old context
#                      again, so a long session costs more on every call.
#                      0 means no limit.
#   --no-poll-tasks    Dispatch on inbox messages only.
#   --once             Run one poll cycle, then exit (tests, cron).
#   --verbose          Log idle cycles too.
#
# Messages: the dispatcher owns the role's inbox. It moves each unread
# message into inbox/<role>/processing/ (an atomic rename, so two dispatchers
# never take the same message), bundles all of them into one prompt, and runs
# the agent once. On success the messages move to read/. On failure they go
# back to the inbox, and after MAX_ATTEMPTS failures to failed/.
#
# Tasks: when `coord next ROLE` lists unclaimed tasks, the dispatcher claims
# one task for its worker and runs the agent on that task only. The claim is
# atomic, so a run never starts for a task that another worker took. If the
# same task set is still unclaimed afterwards, it waits with a doubling
# backoff (capped at MAX_BACKOFF) before it tries again. A changed task set
# dispatches at once.
#
# Sessions and the prompt cache: the session ID is saved to
# .maf/coordination/sessions/<worker>.session and resumed on the next run, so the
# agent keeps its context without staying alive. LLM providers cache the
# session prefix for a limited time after the last request (1 hour for
# Claude Code). A resume after that time resends the whole context at full
# price. So the dispatcher resumes only inside --cache-window, and for at
# most --max-session-runs runs. Otherwise the dispatcher starts a fresh
# session. A run that changed the state of the work ends by writing a short
# handoff note to .maf/coordination/sessions/<worker>.handoff.md, and a fresh
# session starts with that note. If the harness reports an unknown session,
# the dispatcher also starts fresh. Other failures keep the session.
#
# The agent runs with COORD_DIR, COORD_ROLE, COORD_WORKER (default:
# <role>-bot), TASKRC, and COORD_DISPATCHED=1 set, and with stdin closed. Every built-in
# adapter skips permission prompts (hermes --yolo, claude bypassPermissions,
# codex --dangerously-bypass-approvals-and-sandbox): the agent runs every
# tool call without approval. Run it only in a worktree or sandbox you trust
# it with. Two dispatchers for one role need different COORD_WORKER values.
#
# Environment:
#   COORD_DIR       Path to .maf/coordination/ (default: .maf/coordination).
#   COORD_WORKER    Worker ID for the agent (default: <role>-bot).
#   DISPATCHER_LOG  Append log lines to this file (default: stderr).
#
# Ruby: 3.0+ (endless method defs, same as coord).

require "json"
require "fileutils"
require "optparse"
require "rbconfig"
require "shellwords"

module Dispatcher
  MANIFEST = ".maf/config.json"
  COORD_BIN = ".maf/bin/coord"
  MAX_ATTEMPTS = 3
  MAX_BACKOFF = 3600
  REPORT_RETRIES = 1

  Config = Struct.new(:role, :harness, :command, :model, :skill, :no_skill, :interval, :max_turns,
                      :timeout, :idle_timeout, :grace, :completion_signal, :abort_signal,
                      :cache_window, :max_session_runs, :once, :poll_tasks, :worker, :coord_dir, :verbose,
                      keyword_init: true)

  module Log
    def self.line(message)
      text = "[#{Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")}] dispatcher: #{message}"
      path = ENV["DISPATCHER_LOG"]
      path ? File.open(path, "a") { |file| file.puts(text) } : warn(text)
    end
  end

  # Project finds the main checkout from any worktree. `git rev-parse
  # --git-common-dir` returns the main repo's .git dir (relative at the root,
  # absolute in a worktree), so its parent is the main checkout.
  # NOTE: lib/maf/setup_agent.rb carries the same logic; both run standalone.
  module Project
    def self.root
      common = IO.popen(%w[git rev-parse --git-common-dir], err: File::NULL, &:read).to_s.strip
      common.empty? ? Dir.pwd : File.dirname(File.expand_path(common))
    end

    def self.manifest
      JSON.parse(File.read(File.join(root, MANIFEST)))
    rescue Errno::ENOENT, JSON::ParserError
      {}
    end
  end

  # Lead roles own no tasks. They get an inbox prompt and no task polling.
  # NOTE: assets/coord carries the same list; both run standalone.
  LEADS = %w[project-manager architect].freeze

  # EditGrant reads each agent's can_edit from .maf/config.json. On Hermes,
  # a role with can_edit false starts without the file-writing toolsets.
  # NOTE: lib/maf/flow.rb carries the same toolset list; both run standalone.
  module EditGrant
    READ_ONLY_TOOLSETS = "terminal,web,skills,todo,memory,session_search,clarify"

    def self.read_only?(role)
      Project.manifest.fetch("agents", []).any? { |agent| agent["role"] == role && agent["can_edit"] == false }
    end
  end

  # Presence writes .maf/coordination/presence/<worker>.json once per cycle, so
  # `coord who` shows the dispatcher as live while its pid runs.
  module Presence
    def self.write(config)
      dir = File.join(config.coord_dir, "presence")
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "#{config.worker}.json"), JSON.generate(record(config)))
    end

    PS_ENV = { "TZ" => "UTC", "LC_ALL" => "C" }.freeze

    def self.started_at(pid)
      IO.popen(PS_ENV, ["ps", "-o", "lstart=", "-p", pid.to_s], err: File::NULL, &:read).to_s.strip
    rescue SystemCallError
      ""
    end

    def self.record(config)
      { "role" => config.role, "worker" => config.worker, "mode" => "dispatch", "pid" => Process.pid,
        "started" => started_at(Process.pid), "seen_at" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ") }
    end
  end

  # HermesSkill resolves the skill flow.rb generated for a role: the name is
  # <project>-<role>, and the dir is the manifest's hermes_dir (set by
  # `flow.rb --hermes-dir`) or flow.rb's default ~/.hermes/skills.
  module HermesSkill
    DEFAULT_DIR = File.join(Dir.home, ".hermes", "skills")

    def self.name(role) = "#{File.basename(Project.root)}-#{role}"
    def self.dir = Project.manifest.fetch("hermes_dir", DEFAULT_DIR)
    def self.installed?(role) = File.exist?(File.join(dir, name(role), "SKILL.md"))
  end

  # Session persists the agent's session ID across runs, per worker: two
  # dispatchers for one role (different COORD_WORKER values) never share a
  # session or a handoff note. The session file's mtime is the time of the
  # last successful run in that session, so it tells whether the LLM prompt
  # cache is still warm. A failed run does not update it, so the next run
  # treats the cache as colder than it may be. That errs on the cheap side.
  class Session
    attr_reader :path, :handoff_path

    def initialize(coord_dir, worker)
      dir = File.join(coord_dir, "sessions")
      @path = File.join(dir, "#{worker}.session")
      @handoff_path = File.join(dir, "#{worker}.handoff.md")
    end

    def id = lines.first.to_s.empty? ? nil : lines.first

    # The second line counts the runs of the session. Each resume adds the old
    # context again, so --max-session-runs caps the count.
    def runs = lines[1].to_i

    def save(session_id)
      count = session_id == id ? runs + 1 : 1
      FileUtils.mkdir_p(File.dirname(@path))
      File.write(@path, "#{session_id}\n#{count}\n")
    end

    def lines = File.exist?(@path) ? File.read(@path).split("\n").map(&:strip) : []
    def clear = FileUtils.rm_f(@path)
    def idle_seconds = File.exist?(@path) ? Time.now - File.mtime(@path) : Float::INFINITY
    def handoff = File.exist?(@handoff_path) ? File.read(@handoff_path).strip : ""
    def write_handoff(text) = FileUtils.mkdir_p(File.dirname(@handoff_path)) && File.write(@handoff_path, text)
  end

  Message = Struct.new(:path, :from, :text)

  # Mailbox owns a role's inbox: take moves unread messages into processing/,
  # ack moves them to read/, release moves them back (or to failed/).
  class Mailbox
    def initialize(coord_dir, role)
      @dir = File.join(coord_dir, "inbox", role)
    end

    # A crash mid-run leaves messages in processing/. Return them to the inbox.
    def recover = Dir.glob(File.join(@dir, "processing", "*.md")).each { |path| move(path, @dir) }

    def take
      Dir.glob(File.join(@dir, "*.md")).sort.filter_map { |path| claim(path) }
    end

    def ack(messages) = messages.each { |message| move(message.path, File.join(@dir, "read")) }

    def release(messages) = messages.each { |message| move(message.path, *retry_target(message.path)) }

    private

    def claim(path)
      target = move(path, File.join(@dir, "processing"))
      target && parse(target)
    end

    def parse(path)
      header, _blank, body = File.read(path).partition(/\n\n/)
      Message.new(path, header[/^# from: (.+)$/, 1].to_s.strip, body.strip)
    end

    # The attempt count lives in the file name (<stamp>.retry2.md), so it
    # survives a dispatcher restart. The stamp prefix keeps the sort order.
    def retry_target(path)
      attempts = path[/\.retry(\d+)\.md\z/, 1].to_i + 1
      name = File.basename(path).sub(/(\.retry\d+)?\.md\z/, ".retry#{attempts}.md")
      [attempts >= MAX_ATTEMPTS ? File.join(@dir, "failed") : @dir, name]
    end

    # Returns the new path, or nil when another process moved the file first.
    def move(path, dir, name = File.basename(path))
      FileUtils.mkdir_p(dir)
      target = File.join(dir, name)
      File.rename(path, target) && target
    rescue Errno::ENOENT
      nil
    end
  end

  # TaskWatch decides when unclaimed tasks justify another agent run. A new
  # task set dispatches at once; an unchanged one waits a doubling backoff.
  # A set that vanishes and comes back unchanged keeps its old backoff.
  class TaskWatch
    def initialize(interval)
      @interval = interval
      @ids = []
      @attempts = 0
      @next_at = Time.at(0)
    end

    def due?(ids, now = Time.now) = !ids.empty? && (ids.sort != @ids || now >= @next_at)

    def dispatched(ids, now = Time.now)
      @attempts = ids.sort == @ids ? @attempts + 1 : 0
      @ids = ids.sort
      @next_at = now + [@interval * (2**(@attempts + 1)), MAX_BACKOFF].min
    end
  end

  # Prefetch adds live context to a dispatch prompt: the spec of the task the
  # run works on (`coord show ID`) and `git log --oneline -10`. Each part is
  # cut to LIMIT characters. A failed command is logged and left out. A run
  # without a task (a message run) gets only the git log. The agent queries
  # the knowledge graph itself, with a question that fits the task.
  module Prefetch
    LIMIT = 2000

    def self.context(poller, task_id = nil)
      sections = commands(poller, task_id).filter_map { |label, run| section(label, run) }
      sections.empty? ? "" : "\nLive context at dispatch time:\n\n#{sections.join("\n")}"
    end

    def self.commands(poller, task_id)
      log = { "git log --oneline -10" => -> { git_log } }
      task_id ? { "coord show #{task_id}" => -> { poller.show(task_id) } }.merge(log) : log
    end

    def self.section(label, run)
      text = run.call
      Log.line("prefetch failed: #{label}; the prompt goes out without it") unless text
      text && "$ #{label}\n#{bound(text.strip)}\n"
    end

    def self.bound(text) = text.length > LIMIT ? "#{text[0, LIMIT]}\n[cut at #{LIMIT} characters]" : text

    def self.git_log
      output = IO.popen(%w[git log --oneline -10], err: File::NULL, &:read)
      $?.success? ? output : nil
    rescue SystemCallError
      nil
    end
  end

  # Poller reads the role's tasks through coord.
  class Poller
    TASK_ID = /^([0-9a-f-]{36})\b/

    def initialize(env, role)
      @env = env
      @role = role
    end

    def unclaimed_task_ids = next_output.to_s.scan(TASK_ID).flatten

    # The tasks that this worker claimed and did not finish.
    def claimed_task_ids = read("next", @role, "--mine").to_s.scan(TASK_ID).flatten

    # The first task that this worker can claim, or nil. `coord claim` is
    # atomic, so two workers never get one task, and a run always has work.
    def claim_first(ids) = ids.find { |id| coord("claim", id) }

    def coord(*args) = CoordCall.run(@env, *args)
    def next_output = read("next", @role)
    def show(id) = read("show", id)

    private

    # The output of a coord command, or nil when the command fails.
    def read(*args)
      output = IO.popen(@env, CoordCall.command + args, err: File::NULL, &:read)
      $?.success? ? output : nil
    rescue Errno::ENOENT
      nil
    end
  end

  # CoordCall runs coord with this Ruby, so an old system Ruby on the
  # shebang path never parses it.
  module CoordCall
    def self.command
      local = File.expand_path(COORD_BIN)
      [RbConfig.ruby, File.executable?(local) ? local : File.join(Project.root, COORD_BIN)]
    end

    # Returns true when the command succeeds.
    def self.run(env, *args)
      system(env, *command, *args, out: File::NULL, err: File::NULL)
    rescue Errno::ENOENT
      false
    end
  end

  # LeadChores runs the periodic coord checks in the architect dispatcher, at
  # most one time in EVERY seconds. `coord reap` releases the claims of
  # stalled workers. `coord review-watch --once` reads new pull request
  # reviews, only with a github section in .maf/config.json. Both commands
  # write to the architect inbox, so the next cycle starts an architect run.
  class LeadChores
    EVERY = 300

    def initialize(poller, role)
      @poller, @role = poller, role
    end

    def run
      return unless due?

      @last = Time.now
      commands.each { |args| @poller.coord(*args) || Log.line("coord #{args.first} failed") }
    end

    private

    def commands = [["reap"], (%w[review-watch --once] if github?)].compact
    def due? = @role == "architect" && (@last.nil? || Time.now - @last >= EVERY)
    def github? = !Project.manifest.dig("github", "bot_user").to_s.empty?
  end

  Result = Struct.new(:output, :success, :timed_out, :reason)

  # Limits are the run limits besides the hard --timeout. idle: seconds
  # without output before the run fails (0 means off). grace: seconds to
  # wait after a completion signal, and for a child that holds stdout.
  # complete and abort: signal strings in the output (nil means off).
  Limits = Struct.new(:idle, :grace, :complete, :abort) do
    def self.from(config)
      new(config.idle_timeout || 0, config.grace || Spawn::GRACE, config.completion_signal, config.abort_signal)
    end
  end

  # Stream reads the output of a child in a thread and records the time of
  # the last output.
  class Stream
    def initialize(reader)
      @reader = reader
      @lock, @text, @last_at = Mutex.new, String.new, Time.now
      @thread = Thread.new { pump }
    end

    def idle_seconds = Time.now - @last_at
    def include?(signal) = @lock.synchronize { @text.include?(signal.b) }

    # A background grandchild can hold the pipe open after the agent exits.
    # Then the reader thread is still blocked: kill it before closing the pipe,
    # so it never dies with an IOError and never lingers.
    def close(grace)
      @thread.join(grace)
      @thread.kill
      @reader.close
      @lock.synchronize { @text.dup.force_encoding(Encoding::UTF_8) }
    end

    private

    def pump
      loop { append(@reader.readpartial(4096)) }
    rescue EOFError, IOError
      nil
    end

    def append(chunk) = @lock.synchronize { (@text << chunk.b) && (@last_at = Time.now) }
  end

  # Watch decides why a run ends. :exit means the process exited. :complete
  # and :abort mean a signal string appeared in the output. :idle means no
  # output for limits.idle seconds. :timeout means the hard --timeout passed.
  # After a completion signal, the process gets limits.grace seconds to exit.
  class Watch
    TICK = 0.2

    def initialize(timeout, limits)
      @deadline = Time.now + timeout
      @limits = limits
    end

    def grace = @limits.grace

    def wait(waiter, stream)
      loop do
        reason = signal(stream) || (waiter.join(TICK) ? :exit : limit(stream))
        return settle(reason, waiter) if reason
      end
    end

    # A signal in the last output chunk can arrive after the exit.
    def final(reason, output)
      return reason unless reason == :exit

      signal(output) || :exit
    end

    private

    def settle(reason, waiter)
      waiter.join(grace) if reason == :complete
      reason
    end

    def signal(text)
      return :abort if seen?(text, @limits.abort)

      :complete if seen?(text, @limits.complete)
    end

    def seen?(text, signal) = !signal.to_s.empty? && text.include?(signal)

    def limit(stream)
      return :timeout if Time.now >= @deadline

      :idle if @limits.idle.positive? && stream.idle_seconds >= @limits.idle
    end
  end

  # Spawn runs a command in its own process group. Any end reason except a
  # normal exit kills the whole group (TERM, then KILL), which also stops the
  # children of an `sh -c` template. A completion signal is success even when
  # the process must be killed. An abort signal is failure.
  module Spawn
    GRACE = 5
    TIMEOUTS = %i[timeout idle].freeze

    def self.run(cmd, env:, timeout:, limits: Limits.new(0, GRACE))
      reader, writer = IO.pipe
      pid = Process.spawn(env, *cmd, in: File::NULL, out: writer, err: writer, pgroup: true)
      collect(pid, Stream.new(reader.tap { writer.close }), Watch.new(timeout, limits))
    rescue Errno::ENOENT => e
      Result.new(e.message, false, false, :missing)
    end

    def self.collect(pid, stream, watch)
      waiter = Process.detach(pid)
      reason = watch.wait(waiter, stream)
      stop(pid, waiter) unless reason == :exit
      result(stream.close(watch.grace), waiter, watch, reason)
    end

    def self.result(output, waiter, watch, reason)
      reason = watch.final(reason, output)
      success = reason == :complete || (reason == :exit && waiter.value.success?)
      Result.new(output, success, TIMEOUTS.include?(reason), reason)
    end

    def self.stop(pid, waiter)
      Process.kill("TERM", -pid)
      Process.kill("KILL", -pid) unless waiter.join(GRACE)
      true
    rescue Errno::ESRCH
      true
    end
  end

  # Events reads the JSON event lines of a harness run. Each adapter takes
  # its session ID from one specific event, never from free text, so a
  # prompt or a handoff note that the agent echoes cannot supply a false ID.
  module Events
    def self.all(output) = output.lines.filter_map { |line| parse(line.strip) }

    def self.last(output, &match) = all(output).reverse.find(&match) || {}

    def self.parse(line)
      event = line.start_with?("{") ? JSON.parse(line) : nil
      event.is_a?(Hash) ? event : nil
    rescue JSON::ParserError
      nil
    end
  end

  # TokenUsage reads the token usage of one run and adds it to the totals of
  # the worker in .maf/coordination/usage/<worker>.json. Claude Code, Hermes, and
  # Codex report usage. A run without usage data adds nothing. A usage error
  # never fails a run.
  #
  # input_tokens counts every input token, cache reads included.
  # cached_input_tokens counts the cache reads, which cost a fraction of the
  # input price. Claude Code reports cache reads and cache writes outside its
  # input_tokens, so they are added. Codex reports them inside.
  class TokenUsage
    def self.normalize(data)
      return nil unless data.is_a?(Hash)

      { "input_tokens" => input(data),
        "cached_input_tokens" => int(data, "cached_input_tokens", "cache_read_input_tokens"),
        "output_tokens" => int(data, "output_tokens", "completion_tokens") }
    end

    def self.input(data)
      int(data, "input_tokens", "prompt_tokens") + int(data, "cache_read_input_tokens") +
        int(data, "cache_creation_input_tokens")
    end

    def self.int(data, *names) = data.values_at(*names).compact.first.to_i

    def self.sum(list) = list.empty? ? nil : list.reduce { |total, usage| total.merge(usage) { |_, a, b| a + b } }

    def initialize(coord_dir, worker)
      @path = File.join(coord_dir, "usage", "#{worker}.json")
    end

    def add(usage)
      return unless usage

      totals = read
      write(usage.to_h { |key, value| [key, totals[key].to_i + value] }.merge("runs" => totals["runs"].to_i + 1))
    rescue SystemCallError, JSON::ParserError => e
      Log.line("token usage not saved: #{e.message}")
    end

    private

    def read = File.exist?(@path) ? JSON.parse(File.read(@path)) : {}
    def write(data) = FileUtils.mkdir_p(File.dirname(@path)) && File.write(@path, JSON.generate(data))
  end

  module Harness
    # Adapter is the part every built-in adapter shares. Each adapter sets
    # STALE_SESSION to the error its CLI prints for an unknown session ID.
    module Adapter
      def stale_session?(output) = output.include?(self::STALE_SESSION)
      def resume(session_id, *flag) = session_id ? [*flag, session_id] : []
      def present(value) = value.to_s.empty? ? nil : value
      def usage(_output) = nil
    end

    # Hermes: `hermes chat --oneshot`, JSONL output, skill preload.
    module Hermes
      extend Adapter
      STALE_SESSION = "Session not found"

      def self.build_command(config, prompt, session_id)
        cmd = %w[hermes chat --oneshot --yolo --format stream-json -Q]
        cmd += ["--skills", config.skill] if config.skill
        cmd += ["--model", config.model] if config.model
        cmd += ["-t", EditGrant::READ_ONLY_TOOLSETS] if EditGrant.read_only?(config.role)
        cmd += ["--max-turns", config.max_turns.to_s, "--run-budget", run_budget(config).to_s]
        cmd + resume(session_id, "--resume") + ["-q", prompt]
      end

      # Stop Hermes before the dispatcher's kill, so it can still write its result event.
      def self.run_budget(config) = [config.timeout - Spawn::GRACE, 1].max
      def self.result_event(output) = Events.last(output) { |event| event["type"] == "result" }
      def self.result_text(output) = result_event(output)["text"]
      def self.session_id(output) = present(result_event(output)["session_id"])
      def self.usage(output) = TokenUsage.normalize(result_event(output)["usage"])
    end

    # Claude Code: `claude -p` prints one JSON object with session_id and
    # result. `--agent` loads .claude/agents/<role>.md as the session's role.
    module Claude
      extend Adapter
      STALE_SESSION = "No conversation found with session ID"

      def self.build_command(config, prompt, session_id)
        cmd = %w[claude -p --output-format json --permission-mode bypassPermissions --agent] + [config.role]
        cmd += ["--model", config.model] if config.model
        cmd + resume(session_id, "--resume") + [prompt]
      end

      def self.result_event(output) = Events.last(output) { |event| event.key?("result") }
      def self.result_text(output) = result_event(output)["result"]
      def self.session_id(output) = present(result_event(output)["session_id"])
      def self.usage(output) = TokenUsage.normalize(result_event(output)["usage"])
    end

    # Codex: `codex exec` (or `codex exec resume ID`) with JSONL events. Codex
    # has no agent flag, so a fresh session gets .codex/prompts/<role>.md
    # in front of the prompt. A resumed session already has it.
    module Codex
      extend Adapter
      STALE_SESSION = "no rollout found for thread id"

      def self.build_command(config, prompt, session_id)
        cmd = %w[codex exec] + (session_id ? ["resume"] : [])
        cmd += %w[--json --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox]
        cmd += ["-m", config.model] if config.model
        cmd + resume(session_id) + [session_id ? prompt : role_prompt(config.role) + prompt]
      end

      def self.role_prompt(role)
        path = File.join(".codex", "prompts", "#{role}.md")
        File.exist?(path) ? "#{File.read(path)}\n\n" : ""
      end

      def self.result_text(output)
        Events.last(output) { |event| event.dig("item", "type") == "agent_message" }.dig("item", "text")
      end

      def self.session_id(output)
        present(Events.last(output) { |event| event["type"] == "thread.started" }["thread_id"])
      end

      # Codex reports the usage of each turn in a turn.completed event.
      def self.usage(output)
        turns = Events.all(output).select { |event| event["type"] == "turn.completed" }
        TokenUsage.sum(turns.filter_map { |event| TokenUsage.normalize(event["usage"]) })
      end
    end

    # opencode: `opencode run --format json`. `--agent` loads
    # .opencode/agents/<role>.md. The result event shape is not verified, so
    # the log shows no result text. opencode prints terminal escape codes and
    # can glue two JSON objects onto one line, so the session ID is matched on
    # the start of an event object (captured from a real run), not by parsing
    # whole lines.
    module Opencode
      extend Adapter
      STALE_SESSION = "Session not found"
      EVENT_SESSION = /\{"type":"[\w.-]+","timestamp":\d+,"sessionID":"([^"]+)"/

      def self.session_id(output) = output.scan(EVENT_SESSION).flatten.last

      def self.build_command(config, prompt, session_id)
        cmd = %w[opencode run --format json --agent] + [config.role]
        cmd += ["-m", config.model] if config.model
        cmd + resume(session_id, "--session") + [prompt]
      end

      def self.result_text(_output) = nil
    end

    # Generic: a user-provided shell template. No session resume, no parsing.
    module Generic
      PLACEHOLDERS = %i[prompt role skill model].freeze

      def self.build_command(config, prompt, _session_id)
        values = { prompt: prompt, role: config.role, skill: config.skill, model: config.model }
        line = PLACEHOLDERS.reduce(config.command) { |cmd, key| cmd.gsub("%{#{key}}") { values[key].to_s.shellescape } }
        ["sh", "-c", line]
      end

      def self.stale_session?(_output) = false
      def self.session_id(_output) = nil
      def self.result_text(_output) = nil
      def self.usage(_output) = nil
    end

    REGISTRY = { "hermes" => Hermes, "claude" => Claude, "codex" => Codex, "opencode" => Opencode }.freeze

    def self.for(config)
      return Generic if config.command

      REGISTRY.fetch(config.harness) { abort "dispatcher: unknown harness '#{config.harness}'. Use --command." }
    end
  end

  # ReportBlock reads the typed result that an agent puts at the end of its
  # final reply: <report>{"status":"done","tests":"pass","next":"..."}</report>.
  # parse returns nil when no block is present. Otherwise it returns a Parsed
  # with the data or with the validation error.
  # NOTE: lib/maf/flow/prompt_text.rb carries the same REPORT_FORMAT; both run standalone.
  module ReportBlock
    REPORT_FORMAT = '<report>{"status":"<done|blocked|needs_review>","tests":"<pass|fail>","next":"<next>"}</report>'
    STATUSES = %w[done blocked needs_review].freeze
    TESTS = %w[pass fail].freeze
    PATTERN = %r{<report>(.*?)</report>}m
    Parsed = Struct.new(:data, :error)

    def self.parse(text) = text.to_s.scan(PATTERN).flatten.last&.then { |body| check(decode(body.strip)) }

    # Raw harness output holds the block inside a JSON string, with escaped quotes.
    def self.decode(body) = load(body) || load(load(%("#{body}")).to_s)

    def self.load(text)
      JSON.parse(text)
    rescue JSON::ParserError
      nil
    end

    def self.check(value)
      return Parsed.new(nil, "the report block is not a JSON object") unless value.is_a?(Hash)

      error = errors(value).first
      Parsed.new(error ? nil : value, error)
    end

    def self.errors(value)
      [("status must be one of #{STATUSES.join(", ")}" unless STATUSES.include?(value["status"])),
       ("tests must be pass or fail" unless value["tests"].nil? || TESTS.include?(value["tests"])),
       ("status done needs tests pass, not fail" if value["status"] == "done" && value["tests"] == "fail")].compact
    end
  end

  # Verify runs the verify command of .maf/config.json after a successful
  # run, in the worktree. A non-zero exit makes the run no success. No key
  # means no check. Lead roles own no task, so they get no check.
  module Verify
    def self.pass?(config, env)
      command = Project.manifest["verify"].to_s
      return true if command.empty? || LEADS.include?(config.role)

      check(Spawn.run(["sh", "-c", command], env: env, timeout: config.timeout), command)
    end

    def self.check(result, command)
      Log.line("verify command failed (#{command}): #{result.output.lines.last(5).join.strip}") unless result.success
      result.success
    end
  end

  # Outcome decides what a finished run means. No report block keeps the old
  # rule: exit 0 is success. A report block with status done is success.
  # Status blocked or needs_review, and an invalid block, are no success. The
  # session stays, so the next run resumes it.
  class Outcome
    def initialize(session)
      @session = session
    end

    def conclude(block, text)
      keep_handoff(text)
      return finished(text, block) if block.nil? || block.data&.fetch("status") == "done"

      unfinished(block)
    end

    private

    def finished(text, block)
      Log.line("agent finished#{" (no report block)" unless block}: #{text.slice(0, 80)}")
      true
    end

    def unfinished(block)
      reason = block.error ? "an invalid report block: #{block.error}" : "status #{block.data["status"]}"
      Log.line("agent ended with #{reason}; next: #{block.data&.fetch("next", nil) || "-"}")
      false
    end

    # Some models skip the handoff instruction. If no note exists, the agent's
    # final reply becomes the note, so a later fresh session still gets some
    # context. An existing note stays: a run that changed nothing keeps it.
    def keep_handoff(text)
      note = text.gsub(ReportBlock::PATTERN, "").strip
      return if note.empty? || !@session.handoff.empty?

      @session.write_handoff(note)
    end
  end

  # Runner runs one agent dispatch. It resumes the saved session only while
  # the LLM prompt cache is still warm (see --cache-window). A cold session
  # would resend the whole context at full price, so the dispatcher starts a
  # fresh session and hands it the handoff note instead. It also starts
  # fresh when the harness reports that the saved session no longer exists.
  class Runner
    def initialize(config, harness, env)
      @config = config
      @harness = harness
      @env = env
      @session = Session.new(config.coord_dir, config.worker)
    end

    def dispatch(prompt)
      session_id = warm_session_id
      result = attempt(prompt, session_id)
      result = retry_fresh(prompt) if session_id && @harness.stale_session?(result.output)
      report(result)
    end

    private

    def warm_session_id
      id = @session.id
      return id unless id && (cold? || full?)

      expire(id)
    end

    def cold? = @session.idle_seconds > @config.cache_window
    def full? = @config.max_session_runs.to_i.positive? && @session.runs >= @config.max_session_runs

    def expire(id)
      Log.line("session #{id} #{expire_reason}; starting fresh with the handoff note")
      @session.clear
      nil
    end

    def expire_reason
      return "has #{@session.runs} runs, the --max-session-runs limit" unless cold?

      "idle #{(@session.idle_seconds / 60).round}m, past the cache window"
    end

    def attempt(prompt, session_id)
      Log.line("dispatching #{@config.role} (session: #{session_id || "new"})")
      text = Prompt.with_handoff(prompt, @session, session_id) + Prompt.signals(@config)
      spawn(@harness.build_command(@config, text, session_id))
    end

    def spawn(cmd)
      result = Spawn.run(cmd, env: @env, timeout: @config.timeout, limits: Limits.from(@config))
      TokenUsage.new(@config.coord_dir, @config.worker).add(@harness.usage(result.output))
      result
    end

    def retry_fresh(prompt)
      Log.line("session #{@session.id} not found; starting a fresh session")
      @session.clear
      attempt(prompt, nil)
    end

    # A missing or invalid report block resumes the session with the error,
    # at most REPORT_RETRIES times. A harness without a session gets no retry.
    def report(result, retries = REPORT_RETRIES)
      return failed(result) unless result.success

      @harness.session_id(result.output)&.then { |id| @session.save(id) }
      block = ReportBlock.parse(@harness.result_text(result.output) || result.output)
      retry_report?(block, retries) ? report(ask_for_report(block), retries - 1) : conclude(block, result)
    end

    def retry_report?(block, retries) = retries.positive? && @session.id && (block.nil? || block.error)

    def ask_for_report(block)
      problem = block ? "Your report block is invalid: #{block.error}." : "Your final reply has no report block."
      Log.line("#{problem} Resuming session #{@session.id} once for the report block")
      spawn(@harness.build_command(@config, "#{problem}\n#{Prompt.report}", @session.id))
    end

    def conclude(block, result)
      Outcome.new(@session).conclude(block, @harness.result_text(result.output).to_s) &&
        Verify.pass?(@config, @env)
    end

    def failed(result)
      Log.line("agent #{failure_label(result.reason)}: #{result.output.lines.last(5).join.strip}")
      report_timeout if result.reason == :timeout
      false
    end

    TIMEOUT_NOTICE = "Dispatcher run of %<worker>s timed out after %<seconds>ss. The claims stay. " \
                     "If the task needs more time, raise team.timeouts.%<role>s in .maf/config.json."

    # The architect cannot see a dispatcher log. Without this notice, a task waits without a sign.
    def report_timeout
      return if @config.role == "architect"

      text = format(TIMEOUT_NOTICE, worker: @config.worker, seconds: @config.timeout, role: @config.role)
      CoordCall.run(@env, "msg", "--from", @config.role, "architect", text)
    end

    def failure_label(reason)
      { timeout: "timed out after #{@config.timeout}s", idle: "idle for #{@config.idle_timeout}s (no output)",
        abort: "sent the abort signal" }.fetch(reason, "failed")
    end
  end

  # Prompt builds the one-shot work prompt. The coordination rules live in
  # AGENTS.md (installed by bootstrap), so the prompt only adds what is
  # specific to a dispatched run.
  module Prompt
    ONE_SHOT = <<~TEXT
      You run as role %<role>s in one-shot mode. Follow your role file and the coordination rules in AGENTS.md.
      Do not use --wait: nobody is waiting on this session.
    TEXT

    # The dispatcher claims each task. A worker that claims a task itself can
    # take the task of a run that starts next.
    MESSAGE_END = "Handle the messages above. Do not claim a task: the dispatcher claims tasks for you.\n" \
                  "When every message is handled, stop.\n"
    LEAD_END = "You are a lead role. Never claim a task. Handle the messages above.\n" \
               "When every message is handled, stop.\n"

    def self.messages(messages, role)
      bodies = messages.map { |message| "--- message from #{message.from} ---\n#{message.text}\n" }
      ending = LEADS.include?(role) ? LEAD_END : MESSAGE_END
      "The dispatcher took these messages from your inbox:\n\n#{bodies.join("\n")}\n#{rules(role)}#{ending}"
    end

    TASK = <<~TEXT
      The dispatcher claimed task %<id>s for you. Skip the claim step of your work loop.
      Do this task only. Finish it with coord done. Then stop. Do not claim another task.
    TEXT

    def self.task(role, id) = "#{format(TASK, id: id)}#{rules(role)}"

    RESUME = <<~TEXT
      You hold claimed tasks that a previous run did not finish: %<ids>s.
      For each task, run coord show <id> first. If the status is not pending, or the worker is not you, skip the task.
      Otherwise continue the task on its task branch. Finish it with coord done.
      Do not claim another task. When these tasks are done, stop.
    TEXT

    def self.resume(role, ids) = "#{format(RESUME, ids: ids.join(", "))}#{rules(role)}"
    def self.rules(role) = format(ONE_SHOT, role: role)

    HANDOFF = <<~TEXT
      If this run changed the state of your work, overwrite %<path>s with a handoff note for your next session.
      Write at most 300 words: current state, decisions, open questions, and the next step.
      If this run changed nothing, leave the file as it is.
    TEXT

    # A fresh session starts with the previous session's handoff note. A
    # resumed session already has that context. Every run writes a new note
    # while its cache is still warm, which is cheap.
    REPORT = <<~TEXT
      End your final reply with one report block on its own line:
      %<format>s
      Use status done only when the work is complete. Use blocked or needs_review otherwise.
    TEXT

    SIGNALS = <<~TEXT
      When the work is complete, print %<complete>s on its own line as the last output.
      If you give up, print %<abort>s on its own line instead.
    TEXT

    def self.signals(config)
      return "" unless config.completion_signal || config.abort_signal

      format(SIGNALS, complete: config.completion_signal || "-", abort: config.abort_signal || "-")
    end

    def self.report = format(REPORT, format: ReportBlock::REPORT_FORMAT)

    def self.with_handoff(prompt, session, session_id)
      note = session.handoff
      intro = session_id || note.empty? ? "" : "Handoff note from your previous session:\n#{note}\n\n"
      "#{intro}#{prompt}\n#{format(HANDOFF, path: session.handoff_path)}#{report}"
    end
  end

  # StopSignal ends the poll loop after the current agent run. `maf retire`
  # sends TERM. The agent runs in its own process group, so TERM does not
  # reach the agent, and the agent finishes its work first. The trap writes
  # to a pipe, so a TERM also ends the wait between two cycles.
  class StopSignal
    def initialize
      @reader, @writer = IO.pipe
      trap("TERM") { signal }
    end

    # Returns true after the full interval, false when a stop was requested.
    def wait(seconds) = IO.select([@reader], nil, nil, seconds).nil?

    private

    def signal
      @writer.write_nonblock(".")
    rescue IOError, IO::WaitWritable
      nil
    end
  end

  # Main runs the poll + dispatch loop.
  class Main
    def initialize(config)
      @config = config
      @runner = Runner.new(config, Harness.for(config), Main.run_env(config))
      @mailbox = Mailbox.new(config.coord_dir, config.role)
      @poller = Poller.new(Main.run_env(config), config.role)
      @watch = TaskWatch.new(config.interval)
      @chores = LeadChores.new(@poller, config.role)
      @resume = TaskWatch.new(config.interval)
    end

    def self.run_env(config)
      env = { "COORD_DIR" => config.coord_dir, "COORD_ROLE" => config.role, "COORD_WORKER" => config.worker,
              "COORD_DISPATCHED" => "1", "PWD" => Dir.pwd }
      taskrc = File.join(config.coord_dir, "taskrc")
      File.exist?(taskrc) ? env.merge("TASKRC" => taskrc) : env
    end

    def run
      Log.line("started: role=#{@config.role} #{harness_label} #{timing_label}")
      @mailbox.recover
      @stop = StopSignal.new
      cycle_forever
      Log.line("stopped (TERM)") unless @config.once
    rescue Interrupt
      Log.line("stopped (interrupted)")
    end

    # At most one agent run per cycle. A message run comes first. The next
    # cycle claims a task.
    def cycle
      Presence.write(@config)
      @chores.run
      worked = dispatch_messages || (@config.poll_tasks && (dispatch_claimed || dispatch_tasks))
      Log.line("no work this cycle") if @config.verbose && !worked
    end

    private

    def context(task_id = nil) = Prefetch.context(@poller, task_id)
    def timing_label = "interval=#{@config.interval}s cache_window=#{@config.cache_window}s"
    def harness_label = @config.command ? "command=#{@config.command.inspect}" : "harness=#{@config.harness}"

    def cycle_forever
      cycle
      cycle while !@config.once && @stop.wait(@config.interval)
    end

    def dispatch_messages
      messages = @mailbox.take
      return false if messages.empty?

      settle(messages, @runner.dispatch(Prompt.messages(messages, @config.role) + context))
    end

    # Tasks still unclaimed after a message run count as dispatched, so the
    # next cycle backs off instead of starting another run for them.
    def settle(messages, success)
      success ? @mailbox.ack(messages) : @mailbox.release(messages)
      @watch.dispatched(@poller.unclaimed_task_ids) if @config.poll_tasks
      true
    end

    # A run that timed out or crashed leaves its claims. Finish them before new work.
    def dispatch_claimed
      ids = @poller.claimed_task_ids
      return false unless @resume.due?(ids)

      @runner.dispatch(Prompt.resume(@config.role, ids) + context(ids.first))
      @resume.dispatched(ids)
      true
    end

    # The claim comes first, so the run never starts without work.
    def dispatch_tasks
      ids = @poller.unclaimed_task_ids
      return false unless @watch.due?(ids)

      id = @poller.claim_first(ids)
      @watch.dispatched(ids)
      id && run_task(id)
    end

    def run_task(id)
      @runner.dispatch(Prompt.task(@config.role, id) + context(id))
      true
    end
  end

  # Options parses the command line into a Config.
  module Options
    VALUES = { "--harness NAME" => [:harness, String], "--command TEMPLATE" => [:command, String],
               "--model M" => [:model, String], "--skill NAME" => [:skill, String],
               "--interval S" => [:interval, Integer], "--max-turns N" => [:max_turns, Integer],
               "--timeout S" => [:timeout, Integer], "--cache-window S" => [:cache_window, Integer],
               "--max-session-runs N" => [:max_session_runs, Integer],
               "--idle-timeout S" => [:idle_timeout, Integer], "--grace S" => [:grace, Integer],
               "--completion-signal TEXT" => [:completion_signal, String],
               "--abort-signal TEXT" => [:abort_signal, String] }.freeze
    SWITCHES = { "--no-skill" => [:no_skill, true], "--no-poll-tasks" => [:poll_tasks, false],
                 "--once" => [:once, true], "--verbose" => [:verbose, true] }.freeze
    DEFAULTS = { harness: "hermes", interval: 60, max_turns: 50, idle_timeout: 0, grace: Spawn::GRACE,
                 cache_window: 3300, max_session_runs: 5, poll_tasks: true,
                 no_skill: false, once: false, verbose: false }.freeze

    DEFAULT_TIMEOUT = 1500

    def self.parse(argv, env = ENV)
      config = Config.new(**DEFAULTS)
      parser(config).parse!(argv)
      config.role = argv.shift || abort("dispatcher: role is required (usage: dispatcher ROLE)")
      validate(finish(config, env))
    end

    # Reviews and data tasks need more time than code tasks. The team section
    # of .maf/config.json sets a limit for each role: "team": { "timeouts": { "reviewer": 2400 } }.
    def self.role_timeout(role)
      value = Project.manifest.dig("team", "timeouts", role)
      value && Integer(value, exception: false)
    end

    def self.validate(config)
      abort "dispatcher: role must not be empty" if config.role.strip.empty?
      positive = config.interval.positive? && config.timeout.positive?
      abort "dispatcher: --interval and --timeout must be positive" unless positive
      abort "dispatcher: --cache-window must be 0 or more" if config.cache_window.negative?
      validate_limits(config)
    end

    def self.validate_limits(config)
      limits = [config.idle_timeout, config.grace, config.max_session_runs]
      abort "dispatcher: --idle-timeout, --grace, and --max-session-runs must be 0 or more" if limits.any?(&:negative?)
      config
    end

    def self.parser(config)
      OptionParser.new("Usage: dispatcher ROLE [options]") do |o|
        VALUES.each { |flag, (key, type)| o.on(flag, type) { |v| config[key] = v } }
        SWITCHES.each { |flag, (key, value)| o.on(flag) { config[key] = value } }
        o.on("-h", "--help") { puts(o) || exit }
      end
    end

    def self.finish(config, env)
      config.coord_dir = File.expand_path(env.fetch("COORD_DIR", ".maf/coordination"))
      config.worker = env.fetch("COORD_WORKER", "#{config.role}-bot")
      config.timeout ||= role_timeout(config.role) || DEFAULT_TIMEOUT
      config.poll_tasks = false if LEADS.include?(config.role)
      config.skill = nil if config.no_skill
      config.skill ||= HermesSkill.name(config.role) if !config.no_skill && HermesSkill.installed?(config.role)
      config
    end
  end
end

if __FILE__ == $PROGRAM_NAME
  # The agents run `coord`. Put the folder of this script (.maf/bin) on PATH.
  ENV["PATH"] = [File.dirname(File.expand_path(__FILE__)), ENV["PATH"]].compact.join(File::PATH_SEPARATOR)
  Dispatcher::Main.new(Dispatcher::Options.parse(ARGV)).run
end
